BASETEN_API_KEY=
LLM_BASE_URL=https://inference.baseten.co/v1
LLM_MODEL=meta-models/muse-spark-open-1026
LLM_REASONING_EFFORT=medium
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_S=120
PRICE_INPUT_USD_PER_M=1.25
PRICE_OUTPUT_USD_PER_M=4.25
PRICE_CACHED_INPUT_USD_PER_M=0.15
BUDGET_USD_CAP=85
DEMO_BUDGET_USD_CAP=10
LIVE_MODE=false
# Demo app only: how many proxy hops add an X-Forwarded-For entry in front of the app (0 locally;
# 1 on a host whose proxy appends the client's address). Used only for the in-memory per-IP limit.
TRUSTED_PROXY_HOPS=0
# Demo app only: where the per-visitor limit reads the visitor's address. xff (X-Forwarded-For with
# TRUSTED_PROXY_HOPS), header:<Name> (one header the host's proxy sets, e.g. header:X-Real-IP), or none
# (no per-visitor limit; only the global caps apply).
CLIENT_IP_SOURCE=xff
# Demo app only: live runs per hour for all visitors together.
LIVE_RUNS_PER_HOUR=40
# Demo app only: true enables GET /api/debug/client, which shows the caller its own address headers.
DEBUG_CLIENT=false
